local key = loadstring(game:HttpGet("https://raw.githubusercontent.com/ScriptsHubRBX/r/refs/heads/main/key"))()
key:Load("universalrbx","hyper")
key:checkHwid()

for i, v in pairs(game:GetService("CoreGui"):GetChildren()) do
    if v.Name == "ui" then
        v:Destroy()
    end
end
local function load()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/ScriptsHubRBX/r/refs/heads/main/hy"))()
end
if not _G.found then
local UI = loadstring(game:HttpGet("https://raw.githubusercontent.com/ScriptsHubRBX/JTest/refs/heads/main/hh"))()

local gui = UI:Window("Verify")
local tab = gui:Tab("Password")

	tab:Textbox("Enter",nil,function(value)
		local succ = key:verifyKey(value)
		if succ then
			for i, v in pairs(game:GetService("CoreGui"):GetChildren()) do
				if v.Name == "ui" then
					v:Destroy()
				end
			end
			load()
		end
	end)
	else
		load()
end
