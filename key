local SERVICE_ID = nil
local key = {}

function key:Load(service)
local API_BASE_URL = "https://nexus-key-dashboard.replit.app/api"
SERVICE_ID   = service

local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local HttpService    = game:GetService("HttpService")

local player    = Players.LocalPlayer
local HEARTBEAT_INTERVAL = 15

local httpReq = (syn and syn.request)
             or (http and http.request)
             or (fluxus and fluxus.request)
             or request
             or http_request
end

local function httpPost(endpoint, data)
	if not httpReq then
		return nil
	end
	local body = HttpService:JSONEncode(data)
	local ok, res = pcall(function()
		return httpReq({
			Url     = API_BASE_URL .. endpoint,
			Method  = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body    = body,
		})
	end)
	if not ok then
		return nil
	end
	if res.StatusCode ~= 200 then
		return nil
	end
	local dok, decoded = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	if not dok then
		return nil
	end
	return decoded
end

function key:checkHwid()
	local response = httpPost("/roblox/check-hwid", {
		hwid      = tostring(gethwid()),
		serviceId = SERVICE_ID,
	})
	if response == nil then return false, nil, nil end
	return response.found, response.keyValue, response.time
end

function key:verifyKey(keyValue)
	local response = httpPost("/roblox/activate", {
		keyValue  = keyValue,
		hwid      = tostring(gethwid()),
		username  = player.Name,
		serviceId = SERVICE_ID,
	})
	if response == nil then
		return false, "Не удалось подключиться к серверу ключей.", nil
	end
	return response.found, response.message, response.time
end
return key
